# Canonical LF for KiCad numeric fabrication exports and source snapshots.
# Git checkout CRLF conversion must not invalidate PCB/manifest SHA256 claims.
pcb/**/*.gbl text eol=lf
pcb/**/*.gbs text eol=lf
pcb/**/*.gbp text eol=lf
pcb/**/*.gbo text eol=lf
pcb/**/*.gm1 text eol=lf
pcb/**/*.gtl text eol=lf
pcb/**/*.gts text eol=lf
pcb/**/*.gtp text eol=lf
pcb/**/*.gto text eol=lf
pcb/**/*.gbrjob text eol=lf
pcb/**/*.drl text eol=lf
pcb/**/*.csv text eol=lf
pcb/**/*.svg text eol=lf
pcb/**/*.kicad_pcb text eol=lf
pcb/**/*.kicad_sch text eol=lf
pcb/**/*.net text eol=lf
pcb/**/*.rpt text eol=lf
pcb/**/*.json text eol=lf

# Generated PoC decks are compared byte-for-byte against the generator and their
# SHA256 goes into the LTspice evidence JSON; a CRLF checkout would report every
# deck as stale on a default Windows clone (core.autocrlf=true).
sim/v3/poc_*.cir text eol=lf

# LTspice run logs are evidence, not source.  LTspice emits a *mix* of CRLF and
# lone-LF lines (19 CRLF / 18 LF on the 5A pair), so any eol= conversion makes
# the committed blob differ from the bytes the run actually produced and every
# log_sha256 in the evidence JSON becomes unverifiable on a fresh clone.
# Store the run's bytes exactly.
sim/v3/poc_*.log -text

# Datasheet archive is evidence: the provenance JSON records the SHA256 of the
# bytes actually downloaded/extracted.  Git eol conversion would make those
# hashes fail on a fresh checkout even though the file content is unchanged.
# The extracted .txt files carry 0xB0/0xB1/0xB5 bytes and are read as latin-1.
# Scope -text to the files a hash contract points at; a blanket *.txt rule
# renormalizes older archived dumps that no provenance record covers.
references/datasheets/*.pdf -text
references/datasheets/a720v477m2r5ape003_* -text
references/datasheets/kemet_t2078_a720_* -text
references/datasheets/yageo_pb_a720_* -text

# Native EasyEDA G1 evidence is SHA/source-locked. Windows core.autocrlf=true
# must not change committed JSON blobs or the original opaque CAD archive.
hardware/dcx_main/g1/*.json text eol=lf
# Source-bound G2 raw native evidence is compared by SHA on Windows/CI.
hardware/dcx_main/g2/*.json text eol=lf
hardware/dcx_main/gen/*_raw.json text eol=lf
hardware/dcx_main/gen/reference_schematic_connectivity.json text eol=lf
hardware/dcx_main/**/*.eprj2 -text

# Ansys Electronics Desktop .aedt is opaque, natively generated binary CAD.
# Its SHA256 is used in the D1 Maxwell concept evidence; never normalize EOL.
hardware/dcx_main/maxwell/*.aedt -text
hardware/dcx_main/maxwell/*.evidence.json text eol=lf
hardware/dcx_main/maxwell/*.receipt.json text eol=lf
hardware/dcx_main/maxwell/*.results.zip -text
