  "decision": {
    "single_controller_branch_required": true,
    "four_groups_may_not_share_one_22r": true,
    "twenty_two_ohm_proven_at_worst_case": false,
    "twenty_two_ohm_meets_functional_vgs_at_worst_case": true,
    "closing_action": "vendor the ES1D datasheet and read Vf at the ~39 mA branch current.  The corner passes full regulation iff Vf <= 0.904 V; the only vendored number is the 1 A max of 0.92 V, which fails by 16 mV and is not the drop at 39 mA.",
    "required_change_if_diode_does_not_close_it": "do not lower the threshold.  Either (a) specify pass-through operation with a temperature-bounded VGS and re-qualify the FET at that gate drive, or (b) replace the 22 ohm series resistor with a controlled current limit (or an external regulated bias) so the branch current no longer sets the drop.",
    "cannot_share_four_groups": "four controllers on one 22 ohm resistor drop 3.484 V, which is outside any VDD_SR window; each UCC24624 needs its own series branch from VDD_IN."
  },
  "unbound": [
    "IVDDRUN at VVDD = 15 V: the datasheet max is at 12 V only",
    "Qg at VGS = 11.68 V: extrapolated with Ciss_max, not a datasheet point",
    "Qg / IVDDRUN temperature and process spread beyond the 25 C max column",
    "DMP3098L Rds_on and SOA: datasheet not vendored",
    "ES1D Vf and reverse leakage at temperature: datasheet not vendored",
    "REG dropout at VVDD around 12 V: VREGDO is specified at 5 V passthrough only"
  ],
  "schematic_increment": {
    "kind": "PER_CONTROLLER_SERIES_BRANCH",
    "topology": "VDD_IN -> Q50 -> R59(22R 1%) -> D50(anode->cathode) -> VDD_SR",
    "per_controller": true,
    "reference_naming": "one Q50/R59/D50 set per UCC24624 (e.g. R59a..R59d, D50a..D50d)",
    "not_a_bus_limit": true,
    "note": "the Rev B bench drawing keeps one branch for the bench board; integration must instantiate one branch per controller, not one bus resistor for four."
  }
