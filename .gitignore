# LTspice waveform dumps: 31 GB in this tree, reproducibly regenerated by the
# decks under sim/.  A cold-start raw alone is 10.7 GB, far over GitHub's limits.
*.raw

# One-off export of the v1 sweep (38 MB); the v1 numbers live in
# design/v1/simulation_summary.csv, which is committed.
sim/dcx_v1.csv

# Legacy snapshot kept locally for comparison; not part of any current claim.
references/legacy/

# Generated previews and tool caches.
build/
__pycache__/
.pytest_cache/
.ruff_cache/

# Local agent tooling logs.
.agents/skills/**/*.log
.agents/**/bridge.stderr.log
.agents/**/bridge.stdout.log

# Session scratch: issue texts, temporary ledgers, probe project copies.
.tmp_*/

# Throwaway board copies kicad-cli writes zone fills into.  They must live next
# to the board for its fp-lib-table to resolve; a killed run can leave one.
pcb/*/_fill_tmp*
pcb/*/_refill_tmp*
.tmp_*.png
# EasyEDA probe copies.  The client keeps these SQLite files open, so rm can
# still fail with "Device or resource busy" after every session reports closed.
.tmp_*.eprj2

# LTspice run metadata cache; the .log and .cir are the committed evidence.
*.db

# KiCad per-user state (open documents, last view).  The .kicad_pro is NOT
# ignored: without it kicad-cli never loads sym-lib-table and ERC reports every
# custom-library symbol as an unknown library.
*.kicad_prl

# Superseded raw/log evidence, kept locally only
sim/v3/superseded/

# Matched-case archive root (tools/run_d1_50v_matched_cases.py).  Each case
# keeps its staged deck, log and GB-scale raw; the run manifest records the
# deck/raw/log sha256, and a copy of that manifest is committed as the
# evidence.  Nothing here is a source file.
/out/

# Generated Ansys Maxwell/CadQuery concept CAD: reproducible from the source
# JSON and Python code. Keep as CI artifacts, not committed binary/ASCII STEP.
# Local licensed AEDT projects and solver matrices are also machine outputs.
design/v3/maxwell/generated_concept/
design/v3/maxwell/local_runs/
