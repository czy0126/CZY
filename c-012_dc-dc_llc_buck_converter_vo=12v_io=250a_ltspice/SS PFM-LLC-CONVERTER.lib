.SUBCKT PFM-LLC-CONVERTER DH1 DH0 DL1 DL0 FB
+ PARAMS: fmin=50k fmax=100k td1=100n td2=100n tr1=10n tf1=10n tr2=10n tf2=10n
+ Vg_H=18 Vg_L=0 Rso1=2 Rsi1=1 Rso2=2 Rsi2=1 Vout=12
+ f02=5k GA=5k Vref=0.5 ts=100u Vo=0
V11 DH1  11 0
E11  11 DH0 VALUE={MIN(I(V11),0)*Rso1+MAX(I(V11),0)*Rsi1+TANH(TIME/ts)*
+                  MIN(MAX(MIN(SIN(2*PI*SDT(V(T))-PI*V(T)*td1)/tr1,
+                  SIN(2*PI*SDT(V(T))+PI*V(T)*td2)/tf1)*Vg_H/2/PI/V(T),Vg_L),Vg_H)}
V12 DL1  12 0
E12  12 DL0 VALUE={MIN(I(V12),0)*Rso2+MAX(I(V12),0)*Rsi2+TANH(TIME/ts)*
+                  MIN(MAX(MIN(SIN(2*PI*SDT(V(T))-PI*(V(T)*td2+1))/tr2,
+                  SIN(2*PI*SDT(V(T))+PI*(V(T)*td1-1))/tf2)*Vg_H/2/PI/V(T),Vg_L),Vg_H)}
E13   T   0 VALUE={fmin+(fmax-fmin)*V(C)}
E01   C   0 VALUE={LIMIT((V(FF)-V(D))*10k,0,1)}
R01   D   C {GA}
R02   D   E 1
R03   D   F 1
C01   E   C {1/2/PI/f02}
E02   F   0 VALUE={Vref*TANH(TIME/ts+Vo/Vref)}
R04  FB   0 1G
R44  FB  FF {(Vout-0.5)*10k}
C45  FB  FF 100p
R46  FF   0 5k
.ENDS PFM-LLC-CONVERTER